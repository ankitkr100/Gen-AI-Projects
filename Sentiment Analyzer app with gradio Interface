import torch
import gradio as gr

# Use a pipeline as a high-level helper that makes it easy to perform sentiment analysis
from transformers import pipeline

model_path = r"E:\Google Colab on Vscode\Text summary GenAI\Model\models--distilbert--distilbert-base-uncased-finetuned-sst-2-english\snapshots\714eb0fa89d2f80546fda750413ed43d93601a13"

analyzer = pipeline("text-classification", 
                model= model_path)

print(analyzer(["This product is good", "The product is quite expensive"]))

def sentiment_analyzer(review):
    sentiment = analyzer(review)
    return sentiment

demo = gr.Interface(fn=sentiment_analyzer, 
                    inputs = [gr.Textbox(label="Input your review comment",lines=4)],
                    outputs = [gr.Textbox(label = "Sentiment",lines=1)],
                    title="Gen AI Project3: Sentiment Analyzer",
                    description = "This Application is used to analyze sentiment based on comments")
demo.launch()
